# Copia este archivo como .env.local y completa tus claves.
# .env.local NO se sube a GitHub.

# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude a usar
ANTHROPIC_MODEL=claude-sonnet-5-5

# https://www.pexels.com/api/ → gratis con tu cuenta de Pexels
PEXELS_API_KEY=

# Opcional: Wikimedia pide un User-Agent con contacto
WIKIMEDIA_USER_AGENT="EstudioLatitud/0.1 (tu-correo@ejemplo.com)"
