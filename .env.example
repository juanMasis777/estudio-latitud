# Copia este archivo como .env.local y completa tus claves.
# .env.local NO se sube a GitHub.

# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude a usar
ANTHROPIC_MODEL=claude-sonnet-5-5

# https://pixabay.com/api/docs/ → inicia sesión y tu clave aparece en esa página
PIXABAY_API_KEY=

# Opcional. Pexels pausó la emisión de claves nuevas (oct 2026).
# Si consigues una, pégala aquí y la fuente aparece sola.
PEXELS_API_KEY=

# Opcional: Wikimedia pide un User-Agent con contacto
WIKIMEDIA_USER_AGENT="EstudioLatitud/0.1 (tu-correo@ejemplo.com)"
